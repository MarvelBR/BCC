{
  "name": "tpp-language",
  "displayName": "Suporte a Linguagem TPP",
  "description": "Syntax highlighting para a linguagem TPP (linguagem didática usada na disciplina de Implementação de Linguagens de Programação)",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "tpp",
        "aliases": [
          "TPP",
          "tpp"
        ],
        "extensions": [
          ".tpp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tpp",
        "scopeName": "source.tpp",
        "path": "./syntaxes/tpp.tmLanguage.json"
      }
    ]
  }
}
